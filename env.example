# Copy this file to `.env.local` for local development.
#
# Public asset hosting (optional)
# If set, `/assets/...` paths are prefixed with this base URL.
# Example: https://storage.googleapis.com/<bucket>
NEXT_PUBLIC_ASSET_BASE_URL=https://storage.googleapis.com/ft-cloud-game-2

# Optional: host only the large character scenario videos in the original bucket.
# The portfolio deployment uses this while keeping other assets on GitHub Pages.
NEXT_PUBLIC_SCENARIO_ASSET_BASE_URL=https://storage.googleapis.com/ft-cloud-game-2

# Used by Sass/FT image service integration (optional)
NEXT_PUBLIC_FT_SYSTEM_CODE=build-service

# Analytics / tracking (optional in local dev)
# If unset, GTM falls back to the default in `src/utils/environment.ts`.
NEXT_PUBLIC_GTM_ID=
PERMUTIVE_PROJECT_ID=
PERMUTIVE_PUBLIC_API_KEY=

# Site URL (optional)
# Set `NEXT_PUBLIC_URL` in production only (e.g. https://transformingbusiness.ft.com).
# In non-prod (e.g. Vercel preview), prefer `NEXT_PUBLIC_VERCEL_URL` so share URLs
# reflect the current deployment URL.
# If unset in browser, falls back to `window.location.origin`.
NEXT_PUBLIC_VERCEL_URL=
NEXT_PUBLIC_URL=

# Debug logging (optional)
# Set to `true` to enable debug logs in production builds.
NEXT_PUBLIC_DEBUG_LOGS=false

# Scenario video variant override (testing)
# - desktop: force desktop video variants
# - mobile: force mobile video variants
# - auto: choose based on device
NEXT_PUBLIC_SCENARIO_VIDEO_VARIANT=auto


